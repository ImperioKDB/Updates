{
  "browser": {
    "mode": "launch",
    "executable_path": "/usr/bin/chromium",
    "headless": true
  },
  "start_url": {
    "url": "https://htmlhost.co/templates/creative-playground-landing#preview",
    "query": []
  },
  "environment": {
    "viewport": {"width": 1440, "height": 900, "device_scale_factor": 1},
    "locale": "en-US",
    "timezone": "UTC",
    "color_scheme": "light",
    "reduced_motion": "no-preference",
    "service_workers": "block"
  },
  "actions": [
    {"step_id": "observe-preview-state", "action": "wait_for_timeout", "duration_ms": 1500}
  ],
  "storage": {"cookies": [], "local_storage": [], "session_storage": []},
  "secrets": [],
  "capture": {
    "after_each_step": ["screenshot", "dom", "accessibility"],
    "at_end": ["screenshot", "dom", "accessibility", "url", "history"],
    "events": ["console", "page-errors", "frames"],
    "network": {"request_body": false, "response_body": false, "header_values": false}
  },
  "command_timeout_ms": 30000
}
